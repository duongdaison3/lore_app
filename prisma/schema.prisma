generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String   @id @default(cuid())
  username               String   @unique
  email                  String   @unique
  phone                  String?
  name                   String?
  bio                    String?
  avatarUrl              String?
  passwordHash           String
  preferredTones         String[] @default([])
  personalizationEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  journalEntries DailyEntry[]
  memories       Memory[]
  notificationPreference NotificationPreference?
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled          Boolean  @default(false)
  preferredTime    String   @default("20:00") // HH:mm format
  timezone         String   @default("UTC")
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Prompt {
  id                String   @id @default(cuid())
  text              String
  isFollowUp        Boolean  @default(false)
  active            Boolean  @default(true)
  language          String   @default("vi")
  category          String // reflection, memory, gratitude, relationship, identity, creative, future, unhinged
  tone              String // gentle, deep, playful, random, unhinged
  intensity         Int      @default(1) // 1-10
  targetGoals       String[]
  suitableMoods     String[]
  seasonalRelevance String?
  cooldownDays      Int      @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  answers EntryAnswer[]
}

model DailyEntry {
  id          String   @id @default(cuid())
  localDate   String // e.g., "2026-08-17" to enforce one per day per user
  mood        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers  EntryAnswer[]
  memories Memory[]

  @@unique([userId, localDate])
  @@index([userId])
}

model EntryAnswer {
  id        String   @id @default(cuid())
  content   String   @db.Text
  isDraft   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entryId String
  entry   DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([entryId, promptId])
  @@index([entryId])
  @@index([promptId])
}

model Memory {
  id            String    @id @default(cuid())
  userId        String
  type          String // person, preference, goal, recurring_theme, important_event, writing_preference
  content       String
  sourceEntryId String?
  confidence    Float // 0.0 to 1.0
  status        String // candidate, active, rejected, expired
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntry DailyEntry? @relation(fields: [sourceEntryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model TelemetryEvent {
  id         String   @id @default(cuid())
  distinctId String   // Pseudonymous identifier (hashed userId)
  name       String   // e.g., "journal_started", "ai_generation"
  type       String   // "PRODUCT" or "AI"
  metadata   Json     // Clean data (model, latency, prompt category). NO user content.
  createdAt  DateTime @default(now())

  @@index([distinctId])
  @@index([name])
  @@index([createdAt])
}

